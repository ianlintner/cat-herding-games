{
  "routes": [
    {
      "route": "/versions.json",
      "headers": { "cache-control": "no-cache" }
    },
    {
      "route": "/*.{png,jpg,jpeg,gif,webp,avif,svg,ico,woff,woff2,mp3,ogg,wav,mp4,webm}",
      "headers": { "cache-control": "public, max-age=86400" }
    },
    {
      "route": "/assets/*",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*/assets/*-*.js",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*/assets/*-*.css",
      "headers": { "cache-control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/*/assets/*",
      "headers": { "cache-control": "public, max-age=86400" }
    },
    {
      "route": "/thumbnail-*",
      "headers": { "cache-control": "public, max-age=86400" }
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/assets/*",
      "/thumbnails/*",
      "/versions.json",
      "/staticwebapp.config.json",
      "/*.{png,jpg,jpeg,gif,webp,avif,svg,ico,woff,woff2,mp3,ogg,wav,mp4,webm,js,css,json}"
    ]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "gamepad=(self), fullscreen=(self)",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' https://cdn.cat-herding.net blob:; connect-src 'self' https://cdn.cat-herding.net; worker-src 'self' blob:; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
